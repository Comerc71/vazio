# Copie para ".env" e preencha. Nunca faça commit do .env.

# --- Claude (Anthropic) ---
# Chave em https://console.anthropic.com > API Keys
ANTHROPIC_API_KEY=sk-ant-...
# Modelo usado pelo atendente (padrão: claude-opus-5-5)
# CLAUDE_MODEL=claude-opus-5-5

# --- WhatsApp Cloud API (Meta) ---
# developers.facebook.com > seu app > WhatsApp > Configuração da API
WHATSAPP_TOKEN=EAAG...
WHATSAPP_PHONE_NUMBER_ID=123456789012345
# Texto que VOCÊ inventa; o mesmo vai no campo "Verificar token" do webhook na Meta
WHATSAPP_VERIFY_TOKEN=troque-por-um-texto-secreto
# Configurações do app > Básico > Chave secreta do aplicativo (valida que a mensagem veio da Meta)
WHATSAPP_APP_SECRET=
# GRAPH_API_VERSION=v23.0

# --- Dono do negócio ---
# WhatsApp que recebe o aviso quando o robô chama um atendente (só números, com 55 + DDD)
NUMERO_DONO=5591999999999

# --- Servidor ---
PORT=3000
# Arquivo com os dados do negócio (serviços, preços, horários)
# NEGOCIO_ARQUIVO=config/negocio.json
# Pasta onde ficam agendamentos e conversas
# PASTA_DADOS=data
