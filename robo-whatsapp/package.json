{
  "name": "robo-whatsapp",
  "version": "1.0.0",
  "private": true,
  "description": "Atendente de IA para WhatsApp (pet shops, clínicas odontológicas, restaurantes e outros negócios): responde clientes, agenda horários, recebe pedidos e chama um humano quando precisa.",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/servidor.js",
    "chat": "node --env-file-if-exists=.env src/chat-terminal.js",
    "chat:odonto": "node --env-file-if-exists=.env src/chat-terminal.js config/odontologia.json",
    "chat:restaurante": "node --env-file-if-exists=.env src/chat-terminal.js config/restaurante.json",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0"
  }
}
